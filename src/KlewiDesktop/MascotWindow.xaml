<Window x:Class="KlewiDesktop.MascotWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="142" Height="174" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="False" Topmost="True"
 ResizeMode="NoResize" ShowActivated="False">
 <Grid Background="Transparent">
  <Border x:Name="Bubble" Background="#EE17212E" BorderBrush="#52657D" BorderThickness="1"
          CornerRadius="10" Padding="8" Margin="2,0,2,7" VerticalAlignment="Top"
          Visibility="Visible">
   <TextBlock x:Name="SpeechText" Text="Привіт! Я Клеві." Foreground="#EAF1FC"
              FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
  </Border>
  <Canvas x:Name="PetCanvas" Margin="0,48,0,0" Background="Transparent"
          MouseLeftButtonDown="PetCanvas_MouseLeftButtonDown"
          MouseLeftButtonUp="PetCanvas_MouseLeftButtonUp"
          MouseMove="PetCanvas_MouseMove"
          MouseRightButtonUp="PetCanvas_MouseRightButtonUp">
   <Ellipse Width="94" Height="102" Canvas.Left="24" Canvas.Top="7"
            Fill="#111923" Stroke="#52657D" StrokeThickness="2"/>
   <Ellipse Width="16" Height="24" Canvas.Left="43" Canvas.Top="39" Fill="#65F05A"/>
   <Ellipse Width="16" Height="24" Canvas.Left="82" Canvas.Top="39" Fill="#65F05A"/>
   <Ellipse x:Name="LeftPupil" Width="6" Height="10" Canvas.Left="48" Canvas.Top="46" Fill="#102018"/>
   <Ellipse x:Name="RightPupil" Width="6" Height="10" Canvas.Left="87" Canvas.Top="46" Fill="#102018"/>
   <Border x:Name="Mouth" Width="25" Height="5" Canvas.Left="59" Canvas.Top="83"
           Background="#65F05A" CornerRadius="3"/>
   <TextBlock Canvas.Left="47" Canvas.Top="112" Text="KLEWI"
              Foreground="#65F05A" FontSize="9" FontWeight="Bold"/>
  </Canvas>
  <Button x:Name="MenuButton" Content="⋯" Width="24" Height="24" Padding="0"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0"
          Background="#263247" Click="MenuButton_Click"/>
 </Grid>
</Window>