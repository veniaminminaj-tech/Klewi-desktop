<Window x:Class="KlewiDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Klewi Desktop" Width="1180" Height="760" MinWidth="900" MinHeight="600"
 Background="{StaticResource Bg}" Foreground="{StaticResource MainText}" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#141A25" BorderBrush="#263247" BorderThickness="0,0,1,0" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,8,0,28">
      <Border Background="#0C121A" BorderBrush="#34445B" BorderThickness="1" CornerRadius="9" Width="38" Height="38" Padding="7"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="7" Height="7" Background="#65F05A" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Grid.Column="1" Width="7" Height="7" Background="#65F05A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Border Grid.Row="1" Width="13" Height="2" Background="#65F05A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
      <StackPanel Margin="10,0"><TextBlock Text="Klewi" FontSize="21" FontWeight="Bold"/><TextBlock Text="DESKTOP PREVIEW" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
     </StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="{StaticResource Muted}" FontSize="10" Margin="5,0,0,8"/>
     <Button Content="✦  AI Chat" HorizontalContentAlignment="Left" Click="ChatNav_Click"/>
     <Button Content="⌘  Code Assistant" HorizontalContentAlignment="Left" Click="ChatNav_Click"/>
     <Button Content="▣  Project" HorizontalContentAlignment="Left" Click="ProjectNav_Click"/>
     <Button Content="⬡  Minecraft Studio" HorizontalContentAlignment="Left" Click="MinecraftNav_Click"/>
     <Button Content="▤  ISO Tools" HorizontalContentAlignment="Left" Click="IsoNav_Click"/>
     <Button Content="⌘  Terminal" HorizontalContentAlignment="Left" Click="TerminalNav_Click"/>
     <Button Content="⚙  Settings" HorizontalContentAlignment="Left" Click="SettingsNav_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#1B2637" CornerRadius="9" Padding="10">
     <StackPanel><TextBlock Text="Klewi Agent" FontWeight="SemiBold"/><TextBlock Text="Prototype build" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4"/><TextBlock Text="Connect an AI provider in Settings to chat." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18">
    <StackPanel><TextBlock x:Name="PageTitle" Text="AI Chat" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Your coding workspace." Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel>
    <TextBlock x:Name="ProviderStatus" DockPanel.Dock="Right" Text="Provider not configured" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="ChatPage">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
      <ScrollViewer x:Name="ChatScroll"><StackPanel x:Name="Messages">
       <TextBlock Text="Welcome to Klewi" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="A Windows coding assistant prototype. Configure Gemini, OpenAI, or OpenRouter in Settings to enable real AI responses." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
     </Border>
     <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="9">
      <StackPanel>
       <DockPanel Margin="0,0,0,7">
        <TextBlock Text="Coding language:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ChatLanguageCombo" Width="220" SelectedIndex="0" Padding="5" ToolTip="Choose a language or let Klewi detect it">
         <ComboBoxItem Content="Auto-detect"/><ComboBoxItem Content="C# / .NET"/><ComboBoxItem Content="C / C++"/><ComboBoxItem Content="Python"/><ComboBoxItem Content="Java"/><ComboBoxItem Content="JavaScript / TypeScript"/><ComboBoxItem Content="HTML / CSS"/><ComboBoxItem Content="Rust"/><ComboBoxItem Content="Go"/><ComboBoxItem Content="Kotlin"/><ComboBoxItem Content="Swift"/><ComboBoxItem Content="PHP"/><ComboBoxItem Content="Ruby"/><ComboBoxItem Content="Lua"/><ComboBoxItem Content="Dart / Flutter"/><ComboBoxItem Content="R / Julia"/><ComboBoxItem Content="SQL"/><ComboBoxItem Content="Bash / Shell"/><ComboBoxItem Content="PowerShell"/><ComboBoxItem Content="Assembly (FASM)"/><ComboBoxItem Content="Solidity / Smart contracts"/><ComboBoxItem Content="Other / multiple languages"/>
        </ComboBox>
        <TextBlock Text="Klewi Code Assistant • multilingual programming" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
       </DockPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="ChatInput" MinHeight="45" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" KeyDown="ChatInput_KeyDown"/>
        <Button Grid.Column="1" Content="Send  ➤" Background="{StaticResource Accent}" Padding="20,10" Click="Send_Click"/>
       </Grid>
      </StackPanel>
     </Border>
    </Grid>
    <Grid x:Name="ProjectPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="New file" Click="CreateProjectFile_Click"/>
       <Button Content="Save file" Background="{StaticResource Accent}" Click="SaveSelectedFile_Click"/>
       <Button x:Name="AskAIEditButton" Content="AI edit" Click="AskAIEdit_Click"/>
       <Button Content="Open folder…" Click="OpenProject_Click"/>
      </StackPanel>
      <TextBlock x:Name="ProjectPathText" Text="No folder selected" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="12"><TreeView x:Name="ProjectTree" SelectedItemChanged="ProjectTree_SelectedItemChanged" Background="Transparent" Foreground="{StaticResource MainText}" BorderThickness="0"/></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="FilePreviewStatus" Text="Select a text file. You can edit it here, save it, or ask AI to rewrite it." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><TextBox x:Name="FilePreview" Grid.Row="1" IsReadOnly="False" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#0B1018" BorderThickness="0" AcceptsTab="True"/><Button Grid.Row="2" Content="Attach current editor contents to AI chat" HorizontalAlignment="Right" Background="{StaticResource Accent}" Margin="0,10,0,0" Click="UseFileInChat_Click"/></Grid></Border>
     </Grid>
    </Grid>
    <Grid x:Name="MinecraftPage" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
       <StackPanel>
        <TextBlock Text="Minecraft Studio" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Describe the mod or pack. Klewi will generate real project files and package them as a ZIP." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="What are we making?" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="MinecraftTaskCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12">
         <ComboBoxItem Content="Minecraft mod (Java)"/><ComboBoxItem Content="Resource pack"/><ComboBoxItem Content="Texture design (pixel art)"/>
        </ComboBox>
        <TextBlock Text="Mod loader" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="MinecraftLoaderCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12">
         <ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Not applicable (resource pack)"/>
        </ComboBox>
        <TextBlock Text="Minecraft version" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="MinecraftVersionBox" Width="300" HorizontalAlignment="Left" Padding="8" Text="1.21.1" Margin="0,5,0,12"/>
        <TextBlock Text="Project / texture name" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="MinecraftNameBox" Width="420" HorizontalAlignment="Left" Padding="8" Text="My Minecraft Project" Margin="0,5,0,12"/>
        <TextBlock Text="Output folder" Foreground="{StaticResource Muted}"/>
        <DockPanel Margin="0,5,0,12"><TextBox x:Name="MinecraftOutputPathBox" IsReadOnly="True" Padding="8" Text="Documents\\KlewiMinecraft"/><Button DockPanel.Dock="Right" Content="Browse…" Click="ChooseMinecraftOutput_Click"/></DockPanel>
        <TextBlock Text="Describe your idea" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="MinecraftIdeaBox" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="9" Text="Create a new item with a custom texture and crafting recipe."/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
         <Button x:Name="GenerateMinecraftButton" Content="Generate project + ZIP  ✦" Background="{StaticResource Accent}" Padding="18,10" Click="GenerateMinecraft_Click"/>
         <Button x:Name="BuildMinecraftButton" Content="Build mod .jar" Padding="18,10" Click="BuildMinecraftJar_Click"/>
        </StackPanel>
        <TextBlock x:Name="MinecraftStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <Image x:Name="MinecraftTexturePreview" Width="160" Height="160" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,12,0,0"/>
        <TextBox x:Name="MinecraftBuildOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="130" Background="#0B1018" Foreground="#C7D5E8" FontFamily="Consolas" FontSize="11" Margin="0,12,0,0"/>
        <TextBlock Text="Before building a mod, inspect the generated Gradle files. Build runs only after your confirmation because Gradle build scripts execute code." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Supported output" FontWeight="SemiBold"/><TextBlock Text="Mods: Java source, registries, items, blocks, recipes, metadata and build files. Resource packs: pack.mcmeta, model JSON and asset paths. Textures: real 16×16 or 32×32 PNG files generated from an AI-provided pixel grid." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="IsoPage" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
        <StackPanel>
         <TextBlock Text="ISO Tools" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="Перегляд та підключення інсталяційних ISO-образів Windows XP, 7, 8, 10 і 11. Оригінальний ISO-файл не змінюється." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
         <TextBlock Text="Версія Windows в образі" Foreground="{StaticResource Muted}"/>
         <ComboBox x:Name="IsoWindowsVersionCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="3" Padding="7" Margin="0,5,0,12">
          <ComboBoxItem Content="Windows XP"/><ComboBoxItem Content="Windows 7"/><ComboBoxItem Content="Windows 8 / 8.1"/><ComboBoxItem Content="Windows 10"/><ComboBoxItem Content="Windows 11"/>
         </ComboBox>
         <TextBlock Text="ISO-файл" Foreground="{StaticResource Muted}"/>
         <DockPanel Margin="0,5,0,12"><TextBox x:Name="IsoPathBox" IsReadOnly="True" Padding="8" Text="ISO не вибрано"/><Button DockPanel.Dock="Right" Content="Вибрати ISO…" Click="ChooseIso_Click"/></DockPanel>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Інформація + SHA-256" Click="InspectIso_Click" Background="{StaticResource Accent}"/>
          <Button Content="Підключити ISO" Click="MountIso_Click"/>
          <Button Content="Відкрити диск" Click="OpenMountedIso_Click"/>
          <Button Content="Відключити ISO" Click="UnmountIso_Click"/>
         </StackPanel>
         <TextBlock x:Name="IsoStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Вибери ISO-файл, щоб переглянути його властивості або підключити як віртуальний DVD-диск."/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16">
        <StackPanel>
         <TextBlock Text="Що підтримується" FontWeight="SemiBold"/>
         <TextBlock Text="• Windows XP, 7, 8/8.1, 10 і 11 як цільові образи.\n• Перевірка розміру, дати та SHA-256.\n• Підключення ISO у Windows 10/11 та перегляд файлів через Провідник.\n• Безпечне відключення віртуального диска." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
         <TextBlock Text="Обмеження: ця вкладка не створює, не патчить і не записує завантажувальні USB-носії. Для інсталяції використовуй офіційний образ і перевіряй його джерело. Підключення ISO доступне на Windows 8 або новіше." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="TerminalPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#0B1018" CornerRadius="12" Padding="14" Margin="0,0,0,12"><ScrollViewer x:Name="TerminalScroll"><TextBlock x:Name="TerminalOutput" FontFamily="Consolas" Foreground="#C7D5E8" Text="Klewi Terminal Preview&#x0a;Allowed: pwd, dir, ls, dotnet --info, dotnet build, python --version, node --version, npm --version, git status&#x0a;"/></ScrollViewer></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TerminalInput" Height="42" KeyDown="TerminalInput_KeyDown"/><Button Grid.Column="1" Content="Run" Background="{StaticResource Accent}" Click="RunTerminal_Click"/></Grid>
    </Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed">
     <TabControl Background="{StaticResource Panel}" BorderBrush="#34445B" Padding="8">
      <TabItem Header="Instructions">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="AI instructions" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Choose a starting profile, then customize the instructions Klewi follows." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="Instruction profile" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="InstructionPresetCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12" SelectionChanged="InstructionPresetCombo_SelectionChanged">
         <ComboBoxItem Content="Coding assistant"/><ComboBoxItem Content="Explain step by step"/><ComboBoxItem Content="Short answers"/><ComboBoxItem Content="Minecraft mod developer"/><ComboBoxItem Content="Custom instructions"/>
        </ComboBox>
        <TextBlock Text="Your custom instructions" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="SettingsInstructionsBox" MinHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
        <TextBlock Text="These instructions are sent to the selected AI provider with each request." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="API keys">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="AI provider and API keys" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Select a provider and enter its API key and model ID." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="Provider" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="ProviderCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" SelectionChanged="ProviderCombo_SelectionChanged"><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="OpenRouter"/></ComboBox>
        <TextBlock Text="API key" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
        <PasswordBox x:Name="ApiKeyBox" Width="460" HorizontalAlignment="Left" Padding="9" Background="#111722" Foreground="White" BorderBrush="#34445B" Margin="0,5,0,12"/>
        <TextBlock Text="Model ID" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="ModelBox" Width="460" HorizontalAlignment="Left" Padding="9" Text="gemini-2.5-flash"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Save settings" Background="{StaticResource Accent}" Click="SaveSettings_Click"/><Button Content="Test connection" Click="TestConnection_Click"/><Button Content="Browse OpenRouter models" Click="LoadModels_Click"/></StackPanel>
        <TextBlock x:Name="SettingsStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,9,0,0"/>
        <TextBlock Text="API keys are encrypted with Windows DPAPI for the current Windows account." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Minecraft">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="Minecraft Studio defaults" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Set the defaults used when you open Minecraft Studio." Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
        <TextBlock Text="Default Minecraft version" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="SettingsMinecraftVersionBox" Width="300" HorizontalAlignment="Left" Padding="8" Text="1.21.1" Margin="0,5,0,12"/>
        <TextBlock Text="Default mod loader" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="SettingsMinecraftLoaderCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12">
         <ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Not applicable (resource pack)"/>
        </ComboBox>
        <TextBlock Text="Default generation type" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="SettingsMinecraftTaskCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12">
         <ComboBoxItem Content="Minecraft mod (Java)"/><ComboBoxItem Content="Resource pack"/><ComboBoxItem Content="Texture design (pixel art)"/>
        </ComboBox>
        <TextBlock Text="Default output folder" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="SettingsMinecraftOutputBox" Width="460" HorizontalAlignment="Left" Padding="8" Margin="0,5,0,12"/>
        <TextBlock Text="These are defaults only. Generated source files are not automatically executed or compiled." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Chat">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="Chat behavior" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Adjust response creativity and maximum response size." Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
        <TextBlock Text="Creativity" Foreground="{StaticResource Muted}"/>
        <Slider x:Name="SettingsTemperatureSlider" Minimum="0" Maximum="1" Value="0.3" TickFrequency="0.1" IsSnapToTickEnabled="False" Width="360" HorizontalAlignment="Left" Margin="0,8"/>
        <TextBlock Text="0 = more precise; 1 = more creative." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
        <TextBlock Text="Maximum response tokens" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="SettingsMaxTokensBox" Width="160" HorizontalAlignment="Left" Padding="8" Text="4096" Margin="0,5,0,12"/>
       </StackPanel></ScrollViewer>
      </TabItem>
     </TabControl>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
