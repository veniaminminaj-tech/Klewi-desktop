<Window x:Class="KlewiDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Klewi Desktop" Width="1180" Height="760" MinWidth="900" MinHeight="600"
 Background="{StaticResource Bg}" Foreground="{StaticResource MainText}" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#141A25" BorderBrush="#263247" BorderThickness="0,0,1,0" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,8,0,28">
      <Border Background="#0C121A" BorderBrush="#34445B" BorderThickness="1" CornerRadius="9" Width="38" Height="38" Padding="7"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="7" Height="7" Background="#65F05A" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Grid.Column="1" Width="7" Height="7" Background="#65F05A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Border Grid.Row="1" Width="13" Height="2" Background="#65F05A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
      <StackPanel Margin="10,0"><TextBlock Text="Klewi" FontSize="21" FontWeight="Bold"/><TextBlock Text="DESKTOP PREVIEW" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
     </StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="{StaticResource Muted}" FontSize="10" Margin="5,0,0,8"/>
     <Button Content="✦  AI Chat" HorizontalContentAlignment="Left" Click="ChatNav_Click"/>
     <Button Content="▣  Project" HorizontalContentAlignment="Left" Click="ProjectNav_Click"/>
     <Button Content="⬡  Minecraft Studio" HorizontalContentAlignment="Left" Click="MinecraftNav_Click"/>
     <Button Content="⌘  Terminal" HorizontalContentAlignment="Left" Click="TerminalNav_Click"/>
     <Button Content="⚙  Settings" HorizontalContentAlignment="Left" Click="SettingsNav_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#1B2637" CornerRadius="9" Padding="10">
     <StackPanel><TextBlock Text="Klewi Agent" FontWeight="SemiBold"/><TextBlock Text="Prototype build" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4"/><TextBlock Text="Connect an AI provider in Settings to chat." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18">
    <StackPanel><TextBlock x:Name="PageTitle" Text="AI Chat" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Your coding workspace." Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel>
    <TextBlock x:Name="ProviderStatus" DockPanel.Dock="Right" Text="Provider not configured" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="ChatPage">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
      <ScrollViewer x:Name="ChatScroll"><StackPanel x:Name="Messages">
       <TextBlock Text="Welcome to Klewi" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="A Windows coding assistant prototype. Configure Gemini, OpenAI, or OpenRouter in Settings to enable real AI responses." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
     </Border>
     <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="9">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="ChatInput" MinHeight="45" MaxHeight="110" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" KeyDown="ChatInput_KeyDown"/>
       <Button Grid.Column="1" Content="Send  ➤" Background="{StaticResource Accent}" Padding="20,10" Click="Send_Click"/>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="ProjectPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><TextBlock x:Name="ProjectPathText" Text="No folder selected" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Open folder…" Background="{StaticResource Accent}" Click="OpenProject_Click"/></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="12"><TreeView x:Name="ProjectTree" SelectedItemChanged="ProjectTree_SelectedItemChanged" Background="Transparent" Foreground="{StaticResource MainText}" BorderThickness="0"/></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="FilePreviewStatus" Text="Select a text file to preview it." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><TextBox x:Name="FilePreview" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#0B1018" BorderThickness="0"/><Button Grid.Row="2" Content="Use selected file in AI chat" HorizontalAlignment="Right" Background="{StaticResource Accent}" Margin="0,10,0,0" Click="UseFileInChat_Click"/></Grid></Border>
     </Grid>
    </Grid>
    <Grid x:Name="MinecraftPage" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
       <StackPanel>
        <TextBlock Text="Minecraft Studio" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Describe the mod or pack. Klewi will generate real project files and package them as a ZIP." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="What are we making?" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="MinecraftTaskCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12">
         <ComboBoxItem Content="Minecraft mod (Java)"/><ComboBoxItem Content="Resource pack"/><ComboBoxItem Content="Texture design (pixel art)"/>
        </ComboBox>
        <TextBlock Text="Mod loader" Foreground="{StaticResource Muted}"/>
        <ComboBox x:Name="MinecraftLoaderCombo" Width="300" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" Margin="0,5,0,12">
         <ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Not applicable (resource pack)"/>
        </ComboBox>
        <TextBlock Text="Minecraft version" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="MinecraftVersionBox" Width="300" HorizontalAlignment="Left" Padding="8" Text="1.21.1" Margin="0,5,0,12"/>
        <TextBlock Text="Project / texture name" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="MinecraftNameBox" Width="420" HorizontalAlignment="Left" Padding="8" Text="My Minecraft Project" Margin="0,5,0,12"/>
        <TextBlock Text="Output folder" Foreground="{StaticResource Muted}"/>
        <DockPanel Margin="0,5,0,12"><TextBox x:Name="MinecraftOutputPathBox" IsReadOnly="True" Padding="8" Text="Documents\\KlewiMinecraft"/><Button DockPanel.Dock="Right" Content="Browse…" Click="ChooseMinecraftOutput_Click"/></DockPanel>
        <TextBlock Text="Describe your idea" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="MinecraftIdeaBox" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="9" Text="Create a new item with a custom texture and crafting recipe."/>
        <Button x:Name="GenerateMinecraftButton" Content="Generate project + ZIP  ✦" Background="{StaticResource Accent}" HorizontalAlignment="Left" Padding="18,10" Margin="0,14,0,0" Click="GenerateMinecraft_Click"/>
        <TextBlock x:Name="MinecraftStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Text="Generated files are written to the selected folder and packaged into a ZIP. Review generated source code before building or installing it. Mod compilation is not automatic yet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Supported output" FontWeight="SemiBold"/><TextBlock Text="Mods: Java source, registries, items, blocks, recipes, metadata and build files. Resource packs: pack.mcmeta, model JSON and asset paths. Textures: real 16×16 or 32×32 PNG files generated from an AI-provided pixel grid." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="TerminalPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#0B1018" CornerRadius="12" Padding="14" Margin="0,0,0,12"><ScrollViewer x:Name="TerminalScroll"><TextBlock x:Name="TerminalOutput" FontFamily="Consolas" Foreground="#C7D5E8" Text="Klewi Terminal Preview&#x0a;Allowed: pwd, dir, ls, dotnet --info, dotnet build, python --version, node --version, npm --version, git status&#x0a;"/></ScrollViewer></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TerminalInput" Height="42" KeyDown="TerminalInput_KeyDown"/><Button Grid.Column="1" Content="Run" Background="{StaticResource Accent}" Click="RunTerminal_Click"/></Grid>
    </Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed">
     <ScrollViewer><StackPanel>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="AI Provider" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Choose Gemini, OpenAI, or OpenRouter. Enter the matching API key and model ID." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="Provider" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ProviderCombo" Width="260" HorizontalAlignment="Left" SelectedIndex="0" Padding="7" SelectionChanged="ProviderCombo_SelectionChanged"><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="OpenRouter"/></ComboBox>
        <TextBlock Text="API key" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><PasswordBox x:Name="ApiKeyBox" Width="420" HorizontalAlignment="Left" Padding="9" Background="#111722" Foreground="White" BorderBrush="#34445B" Margin="0,5,0,12"/>
        <TextBlock Text="Model ID" Foreground="{StaticResource Muted}"/><TextBox x:Name="ModelBox" Width="420" HorizontalAlignment="Left" Padding="9" Text="gemini-2.5-flash"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Save securely" Background="{StaticResource Accent}" Click="SaveSettings_Click"/><Button Content="Test connection" Click="TestConnection_Click"/><Button Content="Load OpenRouter models" Click="LoadModels_Click"/></StackPanel>
        <TextBlock x:Name="SettingsStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,9,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Safety" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The API key is encrypted with Windows DPAPI. Terminal commands are restricted. This prototype does not remotely control your computer." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
